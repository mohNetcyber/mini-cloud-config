<group name="local,syslog,sshd,">

  <!-- Règle 100001 : Se déclenche à CHAQUE échec SSH (remplacement de if_matched_sid par if_sid) -->
  <rule id="100001" level="10">
    <if_sid>5760, 5710</if_sid>
    <description>Tentative de connexion SSH echouee (mini-cloud)</description>
    <group>authentication_failures,</group>
  </rule>

  <!-- Règle 100002 : Compte la répétition de la règle 100001 -->
  <rule id="100002" level="12" frequency="6" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>Bruteforce SSH probable - plus de 6 echecs en 2 minutes</description>
    <group>authentication_failures,</group>
  </rule>

  <!-- Alertes FIM : modifications fichiers sensibles (Celles-ci sont correctes) -->
  <rule id="100020" level="12">
    <if_sid>550</if_sid>
    <field name="file">/etc/ssh/sshd_config</field>
    <description>ALERTE CRITIQUE : modification detectee sur /etc/ssh/sshd_config</description>
    <group>syscheck,pci_dss_11.5,gpg13_4.11,gdpr_II_5.1.f,hipaa_164.312.c.1,hipaa_164.312.c.2,nist_800_53_SI.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="100021" level="12">
    <if_sid>550</if_sid>
    <field name="file">/etc/passwd</field>
    <description>ALERTE CRITIQUE : modification detectee sur /etc/passwd</description>
    <group>syscheck,pci_dss_11.5,gpg13_4.11,gdpr_II_5.1.f,hipaa_164.312.c.1,hipaa_164.312.c.2,nist_800_53_SI.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>



<group name="k3s_audit,">
  <rule id="100101" level="5">
    <decoded_as>json</decoded_as>
    <field name="kind">Event</field>
    <description>Evenement d'audit K3s recu</description>
    <group>k3s_audit,</group>
  </rule>

  <rule id="100102" level="12">
    <if_sid>100101</if_sid>
    <field name="objectRef.resource">secrets</field>
    <field name="verb" type="pcre2">^(create|update|delete)$</field>
    <description>Modification d'un Secret Kubernetes via l'API</description>
    <group>k3s_audit,</group>
  </rule>

  <rule id="100103" level="10">
    <if_sid>100101</if_sid>
    <field name="objectRef.resource">pods</field>
    <field name="objectRef.subresource">exec</field>
    <description>Execution de commandes dans un pod via l'API Kubernetes</description>
    <group>k3s_audit,</group>
  </rule>
</group>